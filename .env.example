GEMINI_API_KEY=your_gemini_api_key_here
NEWS_API_KEY=your_news_api_key_here
INITIAL_BALANCE=100000
COMMISSION_RATE=0.001

# ── Plaid Open Banking (Real Sandbox) ──────────────────────────────────────
# Sign up free at https://dashboard.plaid.com → Team Settings → Keys
# Copy your client_id and the "Sandbox" secret (NOT Development/Production)
PLAID_CLIENT_ID=your_plaid_client_id_here
PLAID_SECRET=your_plaid_sandbox_secret_here
PLAID_ENV=sandbox  # Keep as "sandbox" for testing with virtual accounts

# Optional (see config.py)
# AUTOPILOT_POLL_INTERVAL=60
# AUTOPILOT_ROUTINE_INTERVAL=300
# AUTOPILOT_RISK_CHANGE_THRESHOLD=10
